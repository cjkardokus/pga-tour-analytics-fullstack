# =============================================================================
# pga-tour-analytics-fullstack .gitignore
#
# Covers all three components of this project as they come online:
#   1. Python  - PySpark data pipeline + FastAPI backend
#   2. Node    - React front-end
#   3. Docker/Spark - local Spark cluster (docker/)
#   4. Project-specific - data/, env/credential files, OS cruft
#
# Add new patterns under the section they belong to, not at the bottom.
# =============================================================================

# =============================================================================
# Python (PySpark pipeline + FastAPI backend)
# Based on the standard GitHub Python.gitignore template.
# =============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Jupyter Notebook
.ipynb_checkpoints/

# pyenv
.python-version

# pipenv / PEP 582 / PDM
Pipfile.lock
__pypackages__/

# Celery
celerybeat-schedule
celerybeat.pid

# Environments (virtualenv - covers venv/, .venv/, env/ and common variants)
.env
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Spyder / Rope
.spyderproject
.spyproject
.ropeproject

# mkdocs / mypy / pyre / pytype
/site
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# Cython debug symbols
cython_debug/

# =============================================================================
# Node / React (front-end - not yet added to the repo)
# =============================================================================

node_modules/

# Build output. Included generically since the front-end tooling isn't
# decided yet: Create React App outputs to build/, Vite defaults to dist/.
# (build/ is already covered by the Python packaging section above.)
dist/

# Environment files (front-end and/or backend) - see "Environment / secrets"
# below in the Project-specific section for why these are never committed.
.env
.env.local
.env.*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# =============================================================================
# Docker / Spark (docker/ local Spark cluster)
# =============================================================================

# Machine-specific Docker Compose config (PROJECT_ROOT, UID, GID) -- every
# clone generates its own via docker/.env.example / docker/README.md.
docker/.env

# Spark event logs / worker scratch dirs, if ever written to a local path
# instead of the tmpfs mount already configured in docker-compose.yml.
docker/spark-events/
docker/**/work/
docker/**/logs/

# =============================================================================
# Project-specific
# =============================================================================

# Pipeline data - raw (downloaded) and processed (generated) output.
# Same pattern as the prior pga-tour-pyspark-pipeline project: this is
# regenerated by the pipeline, not committed.
data/raw/
data/processed/

# --- Environment / secrets --------------------------------------------------
# IMPORTANT: once the FastAPI backend's database config lands (Postgres
# connection string, etc.), it belongs in a .env file that must NEVER be
# committed. .env / .env.local / .env.*.local are already ignored above
# (Node section) and apply here too since dotenv-style files are shared
# across the Python backend and the React front-end. Only ever commit
# .env.example placeholders, following the docker/.env.example pattern.
# -----------------------------------------------------------------------------

# OS-specific files (in case this is ever opened outside WSL2)
.DS_Store
Thumbs.db
