# Copy this file to `.env` (in the project root) and fill in the values
# below. .env is gitignored -- every clone generates its own. This is
# separate from docker/.env: that file configures Docker Compose itself
# (PROJECT_ROOT/UID/GID, plus the same POSTGRES_* values below since the
# postgres container also reads them at startup); this one is read by the
# pipeline (src/pipeline.py, via python-dotenv) to build the JDBC
# connection it writes player_season_stats/courses to.
#
#   cp .env.example .env
#
# POSTGRES_DB / POSTGRES_USER / POSTGRES_PASSWORD: must match the values in
# docker/.env exactly -- these are the same database/user/password the
# postgres container in docker-compose.yml was initialized with (see
# docker/.env.example). If they don't match, the JDBC write will fail to
# authenticate.
POSTGRES_DB=pga_tour_analytics
POSTGRES_USER=pga_tour_analytics
POSTGRES_PASSWORD=changeme

# POSTGRES_HOST / POSTGRES_PORT: how the pipeline's JDBC write reaches
# Postgres. Counter-intuitively this is "postgres:5432" (the Docker-network
# service name/port), NOT "localhost:5432" -- even though the DRIVER runs
# locally on the host in client deploy mode. Unlike spark.read/write
# against local files (resolved by the driver, hence PROJECT_ROOT needing
# to match on both sides -- see docker-compose.yml's top comment), a JDBC
# write opens its actual connections per-partition on the EXECUTORS (see
# JdbcUtils.saveTable in Spark's source), which in this cluster means
# inside the spark-worker container. "localhost" from there is the
# container's own loopback, not the host -- there's nothing listening on
# it. "postgres" resolves correctly because postgres/spark-master/
# spark-worker all share docker-compose.yml's spark-network.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# CORS_ORIGINS: comma-separated list of origins the API's CORSMiddleware
# will accept cross-origin requests from (see api/config.py) -- read by
# the API only, not the pipeline. Defaults to http://localhost:3000 (the
# Create React App dev server's default port) if this isn't set at all,
# so local dev works with zero config; set this explicitly once the
# front-end exists, and again for any deployed origin, e.g.:
#
#   CORS_ORIGINS=http://localhost:3000,https://your-deployed-domain.com
CORS_ORIGINS=http://localhost:3000
