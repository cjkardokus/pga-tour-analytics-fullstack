# Copy this file to `.env.local` (gitignored by Vite's default .gitignore)
# to override. See src/api/client.ts and src/vite-env.d.ts.

# Base URL of the FastAPI backend. Defaults to http://localhost:8000 (the
# port `uvicorn api.main:app --reload` binds to by default -- see root
# README.md) when unset, so local dev works with zero config. Override
# only if your backend runs somewhere else (a different port, or a
# deployed origin).
VITE_API_BASE_URL=http://localhost:8000
